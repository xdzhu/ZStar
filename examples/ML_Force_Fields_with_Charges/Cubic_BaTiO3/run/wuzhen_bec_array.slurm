#!/bin/bash
# One ABACUS/PYATB stage per Slurm array task.  A separate stage list is used
# first for the two reference stages and then for all finite-displacement
# stages, so the 3N(+/-) response calculations are not serialized per frame.
# DFT k-points are generated by ABACUS from kspacing=0.1 in INPUT-scf; no
# fixed primitive-cell KPT is copied into the supercell stages.  PYATB
# sampling is generated by pyatb_input with the common --mp value.
#SBATCH --job-name=zstar-bec-stage
#SBATCH --partition=wzacnormal
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
# Quarantined nodes: j10r2n12 (known failure), j11r2n24 (severely
# oversubscribed), j10r3n39 and j11r1n16 (ABACUS/MPI failures) during the
# 2026-09-14 forward campaign.
#SBATCH --exclude=j10r2n12,j11r2n24,j10r3n39,j11r1n16
#SBATCH --array=0-1%2
#SBATCH --output=slurm-%A_%a.out
#SBATCH --error=slurm-%A_%a.out
set -euo pipefail

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
export MKL_DYNAMIC="${MKL_DYNAMIC:-FALSE}"

BATCH_ROOT=${BATCH_ROOT:?set BATCH_ROOT to the prepared frames directory}
STAGE_LIST=${STAGE_LIST:?set STAGE_LIST to frame_id/stage lines}
read -r FRAME_ID STAGE_NAME < <(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "$STAGE_LIST")
[[ -n "${FRAME_ID:-}" && -n "${STAGE_NAME:-}" ]] || { echo "invalid stage-list entry" >&2; exit 2; }
FRAME_ROOT="$BATCH_ROOT/frame-$FRAME_ID"
STAGE_ROOT="$FRAME_ROOT/$STAGE_NAME"
REFERENCE_ROOT="$FRAME_ROOT/0.no-move"
[[ -d "$STAGE_ROOT" ]] || { echo "missing stage: $STAGE_ROOT" >&2; exit 2; }

if [[ -z "${PYATB:-}" ]]; then
  if [[ -x "$HOME/zstar_qnep_compat/pyatb-systemclean/bin/pyatb" ]]; then
    PYATB="$HOME/zstar_qnep_compat/pyatb-systemclean/bin/pyatb"
  else
    PYATB="$HOME/.local/pyatb-systemclean/bin/pyatb"
  fi
fi
if [[ -z "${PYATB_INPUT:-}" ]]; then
  if [[ -x "$HOME/zstar_qnep_compat/pyatb-systemclean/bin/pyatb_input" ]]; then
    PYATB_INPUT="$HOME/zstar_qnep_compat/pyatb-systemclean/bin/pyatb_input"
  else
    PYATB_INPUT="$HOME/.local/pyatb-systemclean/bin/pyatb_input"
  fi
fi
PYATB_MP="${PYATB_MP:-0.08}"

load_abacus() {
  module purge
  module load compiler/gcc/9.3.0
  module load compiler/intel/2021.3.0
  module load mpi/intelmpi/2021.3.0
  module load mathlib/libxc/4.3.4/intel
  export OMP_NUM_THREADS=1
  export MKL_NUM_THREADS=1
  export PATH=${ABACUS_ROOT:-$HOME/apprepo/abacus/v3.10.0LTS-intelmpi2025/app}/bin:$PATH
  export LD_LIBRARY_PATH=${ABACUS_ROOT:-$HOME/apprepo/abacus/v3.10.0LTS-intelmpi2025/app}/lib:${ABACUS_ROOT:-$HOME/apprepo/abacus/v3.10.0LTS-intelmpi2025/app}/lib64:${LD_LIBRARY_PATH:-}
}

load_mpi() {
  module purge
  module load compiler/gcc/9.3.0
  module load compiler/intel/2021.3.0
  module load mpi/intelmpi/2021.3.0
  export OMP_NUM_THREADS=1
  export MKL_NUM_THREADS=1
  export OPENBLAS_NUM_THREADS=1
  export NUMEXPR_NUM_THREADS=1
  export MKL_DYNAMIC=FALSE
}

cd "$STAGE_ROOT"
cp -f INPUT-scf INPUT
grep -Eiq '^[[:space:]]*kspacing[[:space:]]+0\.1([[:space:]]|$)' INPUT || {
  echo "INPUT must request automatic ABACUS kspacing=0.1" >&2; exit 4;
}
rm -f KPT

if [[ "$STAGE_NAME" != "0.no-move" ]]; then
  [[ -s "$REFERENCE_ROOT/OUT.POLAR/POLAR-CHARGE-DENSITY.restart" ]] || {
    echo "reference charge restart is missing: $REFERENCE_ROOT" >&2; exit 3;
  }
  # ABACUS reads ``init_chg=file`` from OUT.SCF even when the POLAR suffix
  # sends the response outputs to OUT.POLAR.  Put the reference cube/restart
  # where the SCF driver actually looks, while retaining OUT.POLAR for the
  # current stage's response outputs.
  mkdir -p OUT.POLAR OUT.SCF
  for charge in "$REFERENCE_ROOT"/OUT.POLAR/SPIN*_CHG.cube; do
    [[ -s "$charge" ]] && { cp -f "$charge" OUT.POLAR/; cp -f "$charge" OUT.SCF/; }
  done
  cp -f "$REFERENCE_ROOT/OUT.POLAR/POLAR-CHARGE-DENSITY.restart" OUT.POLAR/
  cp -f "$REFERENCE_ROOT/OUT.POLAR/POLAR-CHARGE-DENSITY.restart" OUT.SCF/
fi

if [[ -s OUT.POLAR/data-HR-sparse_SPIN0.csr \
   && -s OUT.POLAR/data-SR-sparse_SPIN0.csr \
   && -s OUT.POLAR/data-rR-sparse.csr ]]; then
  echo "[ABACUS] reuse $FRAME_ID/$STAGE_NAME"
else
  load_abacus
  echo "[ABACUS] run $FRAME_ID/$STAGE_NAME $(date -Is)"
  mpirun -np "${SLURM_NTASKS:-32}" abacus > abacus.out 2>&1
fi

# Keep all generated PYATB inputs frame-specific and reproducible.  This is
# intentionally the only sampling control: pyatb_input derives fermi energy,
# occupied bands, cell, routes, and nk1/nk2/nk3 from the completed SCF.
mkdir -p pyatb
rm -f pyatb/Input pyatb/STRU pyatb/get_Energy.out
"$PYATB_INPUT" --polar --mp "$PYATB_MP" -i "$STAGE_ROOT" -o "$STAGE_ROOT/pyatb" > pyatb_input.out 2>&1
echo "[PYATB_INPUT] $FRAME_ID/$STAGE_NAME mp=$PYATB_MP"
load_mpi
cd pyatb
mpirun -np "${PYATB_MPI_NTASKS:-${SLURM_NTASKS:-32}}" "$PYATB" > pyatb.out 2>&1
echo "[DONE] $FRAME_ID/$STAGE_NAME $(date -Is)"
