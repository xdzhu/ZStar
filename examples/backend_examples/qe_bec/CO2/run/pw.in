&CONTROL
  calculation = 'scf',
  prefix = 'CO2',
  pseudo_dir = './pseudo',
  outdir = '../scratch',
  restart_mode = 'from_scratch',
/
&SYSTEM
  ibrav = 1,
  celldm(1) = 14.0,
  nat = 3,
  ntyp = 2,
  ecutwfc = 60.0,
  nbnd = 10,
  occupations = 'fixed',
  assume_isolated = 'mt',
/
&ELECTRONS
  conv_thr = 1.0d-10,
  mixing_beta = 0.7,
/
ATOMIC_SPECIES
C 12.010 C.pbe-hgh.UPF
O 15.999 O.pbe-hgh.UPF
ATOMIC_POSITIONS angstrom
C 3.000042068 3.000042068 3.544613556
O 3.835408973 3.835408973 3.543705292
O 2.164548959 2.164548959 3.543681153
K_POINTS automatic
1 1 1 0 0 0
